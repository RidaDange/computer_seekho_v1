# Copy this file to `.env` in the same directory and fill in what you need.
#
#   copy .env.example .env        (Windows)
#   cp   .env.example .env        (macOS / Linux)
#
# docker compose reads `.env` automatically. Every value below has a working
# default in docker-compose.yml, so the stack starts even with none of them
# set — a feature whose credentials are missing simply reports itself as
# unavailable at startup instead of failing the boot.
#
# `.env` holds real secrets and must never be committed.

# --- Database ---------------------------------------------------------
# Used for both the MySQL root password and the backend's connection.
# Changing it after the first run has no effect until the data volume is
# removed, because MySQL only reads it when initialising an empty volume:
#   docker compose down -v
DB_PASSWORD=computerseekho

# --- JWT --------------------------------------------------------------
# Must be at least 32 characters; JwtService refuses to start otherwise,
# because HS256 needs a 256-bit key. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# --- Google sign-in (visitor enquiry form) ----------------------------
# From Google Cloud Console -> Google Auth Platform -> Clients.
# The authorised redirect URI registered there must be exactly:
#   http://localhost:8080/api/login/oauth2/code/google
# Leave blank to run without visitor sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ------------------------------------------------------------
# MAIL_PASSWORD is a 16-character Gmail App Password with the spaces
# removed, not the account password. Leave blank to have outbound mail
# logged instead of sent.
MAIL_USERNAME=
MAIL_PASSWORD=
