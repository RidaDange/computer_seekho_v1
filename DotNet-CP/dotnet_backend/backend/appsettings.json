{
  "ConnectionStrings": {
    "Default": "server=localhost;port=3306;database=computerseekho;user=root;password=Pr@23012004;AllowPublicKeyRetrieval=true;SslMode=None"
  },

  "Jwt": {
    "Issuer": "ComputerSeekho",
    "Audience": "ComputerSeekhoClient",
    "Key": "change-this-in-prod-to-a-long-random-secret",
    "ExpirationMinutes": 1440,
    "VisitorExpirationMinutes": 60
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  // Google sign-in for visitors on the public enquiry form.
  //
  // Leave blank to run without it — the app still starts, and logs a warning
  // saying the public form will refuse submissions.
  //
  // The redirect URI to register in Google Cloud Console is:
  //   http://localhost:5192/api/signin-google
  // (different from the Java backend's, so list both.)
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },

  // Where the browser is sent once a visitor token has been issued. Read
  // verbatim by the React app's OAuthCallback page.
  "OAuth2": {
    "RedirectUri": "http://localhost:5173/oauth/callback"
  },

  "JavaService": {
    "BaseUrl": "http://localhost:8080"
  },

  // Outbound email. Mirrors the Java backend's spring.mail.* settings, so the
  // same Gmail app password works for both.
  //
  // Leave Username blank (or set Enabled to false) to run without email —
  // messages are logged instead of sent, and nothing fails.
  //
  // Gmail needs an App Password, not the account password. That requires
  // 2-Step Verification to be switched on first.
  "Mail": {
    "Enabled": true,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "",
    "TimeoutMs": 5000
  },

  "Uploads": {
    "Directory": "./uploads"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
